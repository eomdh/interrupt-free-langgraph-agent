# 이 파일을 .env로 복사해서 쓴다. .env는 커밋되지 않는다.
#
# 아무것도 안 바꿔도 목 모드로 돈다. 키는 실제 모델을 붙일 때만 필요하다.

# fake  = 정해진 응답을 돌려주는 목. 키가 없어도 전 구간이 돈다 (기본)
# openai = OpenAI 호환 엔드포인트를 실제로 호출
LLM_MODE=fake

# OpenAI 호환이면 무엇이든 된다 — base_url만 바꾸면 제공자가 바뀐다.
#   OpenRouter  https://openrouter.ai/api/v1
#   OpenAI      https://api.openai.com/v1
#   Groq        https://api.groq.com/openai/v1
#   Ollama      http://localhost:11434/v1   (키는 아무 값이나)
OPENAI_BASE_URL=https://openrouter.ai/api/v1
OPENAI_API_KEY=
LLM_MODEL=

# docker compose가 알아서 넣어준다. 로컬에서 직접 띄울 때만 쓴다.
# DATABASE_URL=postgresql://agent:agent@localhost:5432/agent
